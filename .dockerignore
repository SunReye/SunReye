**/node_modules
.git

# Core dumps and other large local junk that must never enter the build context
core
**/core
*.core
*.tgz

# Build outputs.
#
# ANCHORED ON PURPOSE, for the reason spelled out in .gitignore: a doubled-star
# name matches at EVERY depth, so it also drops a SOURCE directory that happens
# to carry the name — before `docker build` ever sees the context. That is worse
# than the .gitignore version of this mistake, because git tracks the file and
# every local check passes: only the image build fails, on an unresolved import,
# pointing at a file that is plainly right there in the tree.
# `apps/web/src/lib/build/` was dropped here exactly that way.
/dist
/build
apps/*/dist
apps/*/build
packages/*/dist
packages/*/build
**/.next
**/.nuxt
**/.output
**/.svelte-kit
**/.astro
**/.turbo
.turbo

**/.wrangler
**/.alchemy
**/.expo
**/.vercel
*.log

Dockerfile
**/Dockerfile
docker-compose.yml

# Secrets stay out of image layers; runtime env comes from compose env_file,
# build-time public values come from compose build args
**/.env
**/.env.*
!**/.env.example
