{
  "name": "sunreye",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "gate": "bun scripts/gate.ts",
    "prepare": "husky",
    "image:smoke": "bun scripts/image-smoke.ts",
    "bench": "bun scripts/bench.ts",
    "smoothness": "bun run --cwd apps/web smoothness",
    "build:profiles": "bun packages/sdk/src/cli.ts build profiles",
    "publish:profiles": "bun scripts/publish-profiles.ts",
    "release": "bun scripts/release.ts",
    "release:rehearse": "bun scripts/release-rehearsal.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.92.0",
    "@rsvelte/cli": "0.5.0",
    "@types/bun": "1.4.4",
    "fallow": "3.41.0",
    "husky": "9.1.7",
    "oxlint": "1.92.0",
    "playwright": "1.65.0",
    "tsrs": "7.1.0-beta.tsrs4"
  },
  "packageManager": "bun@1.4.0"
}
