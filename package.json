{
  "name": "SunReye",
  "version": "1.2.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "better-auth": "1.6.22",
      "@better-auth/api-key": "1.6.22"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run db:migrate -F @SunReye/db && turbo run dev db:watch db:studio",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "preview": "turbo run db:migrate -F @SunReye/db && turbo run preview -F web -F server",
    "db:push": "turbo run db:push -F @SunReye/db",
    "db:studio": "turbo run db:studio -F @SunReye/db",
    "db:generate": "turbo run db:generate -F @SunReye/db",
    "db:migrate": "turbo run db:migrate -F @SunReye/db",
    "db:timescale": "turbo run db:timescale -F @SunReye/db",
    "db:start": "docker compose -f docker-compose.db.yml up -d --wait",
    "db:watch": "docker compose -f docker-compose.db.yml logs -f",
    "db:stop": "docker compose -f docker-compose.db.yml stop",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "SKIP_ENV_VALIDATION=1 bun test apps/*/src packages/*/src ./scripts",
    "test:coverage": "SKIP_ENV_VALIDATION=1 bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage apps/*/src packages/*/src ./scripts",
    "test:required": "bun scripts/require-tests.ts",
    "test:floor": "bun scripts/coverage-floor.ts coverage/lcov.info",
    "test:mocks": "bun scripts/mock-hygiene.ts",
    "test:nginx": "bun scripts/nginx-locations.ts",
    "test:storage": "bun scripts/storage-tuning.ts",
    "e2e": "bun run --cwd apps/web e2e",
    "e2e:install": "bun run --cwd apps/web e2e:install",
    "e2e:types": "bun run --cwd apps/web e2e:types",
    "coverage:badge": "bun run scripts/coverage-badge.mjs coverage/lcov.info coverage/coverage.svg",
    "check": "oxlint && oxfmt --write",
    "sync:beta-addon": "node scripts/sync-beta-addon.mjs",
    "sync:brand": "node scripts/sync-brand.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@SunReye/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@SunReye/config": "workspace:*",
    "@SunReye/inverter-core": "workspace:*",
    "@types/bun": "catalog:",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write"
    ],
    "**/*.svelte": [
      "oxlint"
    ],
    "**/*.{ts,tsx,js,jsx,svelte,json,jsonc}": [
      "sh -c 'bunx fallow audit --quiet'"
    ],
    "apps/web/messages/*.json": [
      "sh -c 'cd apps/web && bun run i18n:lint'"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "svelte@5.56.4": "patches/svelte@5.56.4.patch",
    "layerchart@2.2.0": "patches/layerchart@2.2.0.patch"
  }
}
