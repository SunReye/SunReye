{
  "name": "SunReye",
  "version": "3.6.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "better-auth": "1.6.22",
      "@better-auth/api-key": "1.6.22"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run db:migrate -F @SunReye/db && turbo run dev db:watch db:studio",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "preview": "turbo run db:migrate -F @SunReye/db && turbo run preview -F web -F server",
    "compile": "turbo run compile -F server",
    "binary": "turbo run start:binary -F server",
    "db:push": "turbo run db:push -F @SunReye/db",
    "db:studio": "turbo run db:studio -F @SunReye/db",
    "db:generate": "turbo run db:generate -F @SunReye/db",
    "db:migrate": "turbo run db:migrate -F @SunReye/db",
    "db:timescale": "turbo run db:timescale -F @SunReye/db",
    "db:start": "docker compose -f docker-compose.db.yml up -d --wait",
    "db:watch": "docker compose -f docker-compose.db.yml logs -f",
    "db:stop": "docker compose -f docker-compose.db.yml stop",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "bun run test:timing && SKIP_ENV_VALIDATION=1 bun test --parallel apps/*/src packages/*/src ./scripts && cargo test --workspace",
    "test:unit": "SKIP_ENV_VALIDATION=1 bun test --parallel apps/*/src packages/*/src ./scripts",
    "test:factory": "python3 -B -m unittest discover -s scripts/factory -p 'test_*.py' && scripts/factory/check-result-lines",
    "test:coverage": "SKIP_ENV_VALIDATION=1 bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage apps/*/src packages/*/src ./scripts",
    "test:components": "bun run --cwd apps/web test:components",
    "test:required": "bun scripts/require-tests.ts",
    "test:rust": "cargo nextest --version >/dev/null 2>&1 || { echo 'cargo-nextest missing: cargo install cargo-nextest --locked' >&2; exit 1; } && cargo nextest run --workspace",
    "test:coverage:rust": "mkdir -p coverage && cargo llvm-cov --workspace --lcov --output-path coverage/rust-lcov.info",
    "test:floor": "bun scripts/coverage-floor.ts coverage/lcov.info",
    "test:floor:rust": "bun scripts/coverage-floor.ts --rust",
    "test:db": "SKIP_ENV_VALIDATION=1 bun test --timeout 60000 apps/server/db-tests",
    "test:oracle": "SKIP_ENV_VALIDATION=1 bun test --timeout 120000 scripts/oracle",
    "oracle:generate": "bun scripts/oracle/generate.ts",
    "test:routes": "bun scripts/route-smoke.ts",
    "test:budgets": "bun scripts/budget-gate.ts",
    "replay:rehearse": "bun scripts/replay-rehearsal.ts",
    "test:mocks": "bun scripts/mock-hygiene.ts",
    "test:timing": "bun scripts/timing-hygiene.ts",
    "test:binary": "bun scripts/compiled-binary.ts",
    "test:static-env": "bun scripts/static-build-env.ts",
    "test:storage": "bun scripts/storage-tuning.ts",
    "test:wear": "bun scripts/storage-wear.ts",
    "fixture:1.2.0": "bun scripts/fixture-1-2-0.ts",
    "fixture:1.2.0:fast": "bun scripts/fixture-1-2-0.ts --fast --reset",
    "e2e": "bun run --cwd apps/web e2e",
    "bench:e2e": "bun run --cwd apps/web bench:e2e",
    "e2e:install": "bun run --cwd apps/web e2e:install",
    "e2e:types": "bun run --cwd apps/web e2e:types",
    "e2e:core": "bun run --cwd apps/web e2e:core",
    "coverage:badge": "bun run scripts/coverage-badge.mjs coverage/lcov.info coverage/coverage.svg",
    "check": "oxlint && oxfmt --write",
    "sync:beta-addon": "node scripts/sync-beta-addon.mjs",
    "sync:brand": "node scripts/sync-brand.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@SunReye/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@SunReye/config": "workspace:*",
    "@SunReye/inverter-core": "workspace:*",
    "@types/bun": "catalog:",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "**/*.svelte": [
      "oxlint"
    ],
    "**/*.{ts,tsx,js,jsx,svelte,json,jsonc}": [
      "sh -c 'bunx fallow audit --quiet'"
    ],
    "apps/web/messages/*.json": [
      "sh -c 'cd apps/web && bun run i18n:lint'"
    ]
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "npm:@rsvelte/vite-plugin-svelte@^0.5.3"
  },
  "patchedDependencies": {
    "layerchart@2.2.0": "patches/layerchart@2.2.0.patch",
    "@elysia/openapi@2.0.0-beta.1": "patches/@elysia%2Fopenapi@2.0.0-beta.1.patch"
  }
}
