{
  "name": "server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "mkdir -p ../web/build && bun build --compile --minify --sourcemap --external serialport --asset ../web/build ./src/main.ts --outfile server",
    "start:binary": "./server",
    "start": "bun run dist/index.mjs",
    "dev": "while true; do bun run --watch src/index.ts; [ $? -eq 75 ] || break; done",
    "preview": "bun run dist/index.mjs",
    "test": "SKIP_ENV_VALIDATION=1 bun test ./src"
  },
  "dependencies": {
    "@SunReye/auth": "workspace:*",
    "@SunReye/db": "workspace:*",
    "@SunReye/env": "workspace:*",
    "@SunReye/inverter-core": "workspace:*",
    "@elysia/compress": "2.0.0-beta.1",
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.1",
    "@logtape/logtape": "^2.2.3",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "elysia": "2.0.0-beta.7",
    "exact-mirror": "^1.2.2",
    "mqtt": "^5.10.1",
    "openapi-types": "^12.1.3",
    "typebox": "^1.3.19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@SunReye/config": "workspace:*",
    "@SunReye/contracts": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:"
  }
}
