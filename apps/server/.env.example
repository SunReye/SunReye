BETTER_AUTH_SECRET=ypTtHSEJfSF50+3kbQFBCX7v5/JnGlZpoHs3ss8a+2pWoUe6zIO3ORFNlDhPJAsX
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:4173
DATABASE_URL=postgresql://postgres:password@localhost:5432/SunReye
INVERTER_SIMULATE=false
# Optional — seed the DB-backed config on first boot, or configure from the UI.
# INVERTER_PROFILE defaults to the first installed profile when unset.
# INVERTER_PROFILE=deye-sg05lp3
# INVERTER_HOST=10.20.0.62
# INVERTER_PORT=502
# INVERTER_UNIT_ID=0
# INVERTER_TRANSPORT=tcp   # or rtu-over-tcp, or solarman-v5
# A Solarman logging stick (LSW-3/LSE-3) speaks solarman-v5 on port 8899 — it is
# NOT a Modbus-TCP gateway, so plain tcp against it only ever times out. The
# stick's own serial is discovered on connect; set it only to save that round
# trip (it is printed inside the dongle's shell).
# INVERTER_LOGGER_SERIAL=3168930341
POLL_INTERVAL_MS=1000
# Batch history writes: flush buffered rows every N ms in one transaction to
# reduce SSD write wear. A crash can lose at most this window of history.
HISTORY_FLUSH_INTERVAL_MS=5000