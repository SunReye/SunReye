INVERTER_SIMULATE=false
# Optional — seed the DB-backed config on first boot, or configure from the UI.
# INVERTER_PROFILE defaults to the first installed profile when unset.
# INVERTER_PROFILE=deye-sg05lp3
# INVERTER_HOST=10.20.0.62
# INVERTER_PORT=502
# INVERTER_UNIT_ID=0
# INVERTER_TRANSPORT=tcp   # or rtu-over-tcp, or solarman-v5
# A Solarman/IGEN WiFi logger stick: transport solarman-v5, port 8899. The
# serial below is discovered by the connection test — set it only if that fails.
# INVERTER_LOGGER_SERIAL=1234567890
POLL_INTERVAL_MS=1000
# Batch history writes: flush buffered rows every N ms in one transaction to
# reduce SSD write wear. A crash can lose at most this window of history.
HISTORY_FLUSH_INTERVAL_MS=5000