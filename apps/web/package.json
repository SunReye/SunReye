{
  "name": "web",
  "version": "3.1.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:static": "SVELTEKIT_ADAPTER=static PUBLIC_SERVER_URL= vite build && bun scripts/relativize-fallback.ts && bun scripts/check-build.ts",
    "preview": "PORT=4173 node build/index.js",
    "paraglide": "bun scripts/compile-i18n.ts",
    "gen:core-api": "bun scripts/gen-core-api.ts",
    "i18n:lint": "bun scripts/i18n-lint.ts",
    "prepare": "bun scripts/compile-i18n.ts && (svelte-kit sync || echo '')",
    "check": "bun scripts/compile-i18n.ts && svelte-kit sync && rm -rf .svelte-check && TSGO_BIN=tsrs rsvelte-check --tsgo --tsconfig ./tsconfig.json --ignore e2e",
    "check:watch": "svelte-kit sync && TSGO_BIN=tsrs rsvelte-check --tsgo --tsconfig ./tsconfig.json --ignore e2e --watch",
    "test": "SKIP_ENV_VALIDATION=1 bun test ./src",
    "test:components": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "bench:e2e": "playwright test -c playwright.bench.config.ts",
    "e2e:core": "cargo build --manifest-path ../../Cargo.toml -p sunreye -p sunreye-sim --bins && playwright test -c playwright.core.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:types": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@SunReye/inverter-core": "workspace:*",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dotenv": "catalog:",
    "openapi-fetch": "^0.17.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@SunReye/config": "workspace:*",
    "@SunReye/contracts": "workspace:*",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@inlang/paraglide-js": "^2.22.0",
    "@internationalized/date": "^3.12.0",
    "@playwright/test": "^1.62.1",
    "@rsvelte/svelte-check": "^0.5.32",
    "@rsvelte/vite-plugin-svelte": "^0.5.3",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "5.0.3",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "layerchart": "2.2.0",
    "mode-watcher": "^1.1.0",
    "openapi-typescript": "^7.13.0",
    "phosphor-svelte": "^3.1.0",
    "shadcn-svelte": "^1.3.0",
    "svelte": "5.57.1",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.0.10",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "3.1.0"
  }
}
