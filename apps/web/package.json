{
  "name": "@sunreye/web",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "i18n": "bun scripts/i18n.ts",
    "car": "bun scripts/car.ts",
    "smoothness": "bun e2e/smoothness.ts",
    "flash": "bun e2e/flash.ts",
    "gallery": "bun e2e/gallery.ts",
    "build": "bun run wasm && bun run i18n && vite build",
    "api": "SUNREYE_UPDATE_OPENAPI=1 cargo test -q -p sunreye-core --lib committed_openapi && bun run api:types",
    "api:types": "openapi-typescript ../../crates/core/openapi.json -o src/lib/api/schema.d.ts",
    "api:check": "bun run api:types --check",
    "sync": "bun run i18n && svelte-kit sync",
    "check": "bun run sync && rsvelte typecheck && rsvelte lint",
    "test:components": "bun run wasm && bun run i18n && bun ../../scripts/components.ts",
    "wasm": "cargo build --locked --release -p sunreye-pv-wasm --target wasm32-unknown-unknown"
  },
  "dependencies": {
    "@scalar/api-reference": "1.76.4",
    "openapi-fetch": "0.17.0",
    "web-haptics": "0.0.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.6.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.71.0",
    "@sunreye/catalogue": "workspace:*",
    "@sunreye/tokens": "workspace:*",
    "@sunreye/ui": "workspace:*",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/table-core": "8.21.3",
    "@types/d3-shape": "3.1.7",
    "@types/three": "0.187.0",
    "@vitest/browser-playwright": "5.1.0",
    "bits-ui": "2.20.6",
    "clsx": "2.1.1",
    "d3-shape": "3.2.1",
    "embla-carousel-svelte": "8.6.0",
    "layerchart": "2.9.2",
    "meshoptimizer": "1.3.0",
    "mode-watcher": "1.1.0",
    "openapi-typescript": "7.13.0",
    "paneforge": "1.0.2",
    "playwright": "1.65.0",
    "shadcn-svelte": "1.8.0",
    "svelte": "5.57.3",
    "svelte-sonner": "1.2.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "typescript": "6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  }
}
