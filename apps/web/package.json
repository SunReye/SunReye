{
  "name": "@sunreye/web",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n": "bun scripts/i18n.ts",
    "build": "bun run i18n && vite build",
    "api": "SUNREYE_UPDATE_OPENAPI=1 cargo test -q -p sunreye-core --lib committed_openapi && bun run api:types",
    "api:types": "openapi-typescript ../../crates/core/openapi.json -o src/lib/api/schema.d.ts",
    "api:check": "bun run api:types --check",
    "format:check": "prettier --check \"src/**/*.svelte\"",
    "sync": "bun run i18n && svelte-kit sync",
    "check": "bun run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:components": "bun run i18n && vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.6.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@vitest/browser-playwright": "5.1.0",
    "layerchart": "2.9.2",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  }
}
