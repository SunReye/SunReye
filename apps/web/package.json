{
  "name": "@sunreye/web",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "i18n": "bun scripts/i18n.ts",
    "build": "bun run wasm && bun run i18n && vite build",
    "api": "SUNREYE_UPDATE_OPENAPI=1 cargo test -q -p sunreye-core --lib committed_openapi && bun run api:types",
    "api:types": "openapi-typescript ../../crates/core/openapi.json -o src/lib/api/schema.d.ts",
    "api:check": "bun run api:types --check",
    "format:check": "prettier --check \"src/**/*.svelte\"",
    "sync": "bun run i18n && svelte-kit sync",
    "check": "bun run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:components": "bun run wasm && bun run i18n && vitest run",
    "wasm": "cargo build --locked --release -p sunreye-pv-wasm --target wasm32-unknown-unknown",
    "prototype": "vite dev --port 5199 --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.6.0",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-shape": "3.2.0",
    "@types/three": "0.187.0",
    "@vitest/browser-playwright": "5.1.0",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "d3-shape": "3.2.0",
    "layerchart": "2.9.2",
    "mode-watcher": "^1.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-sonner": "^1.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0",
    "web-haptics": "0.0.6"
  }
}
