      "key": "grid.import_power",
      "role": "extra.grid_import_power",
      "compute": {
        "clamp": {
          "key": "ac.total_power",
          "min": 0
        }
      }
    },
    {
      "key": "grid.export_power",
      "role": "extra.grid_export_power",
      "compute": {
        "diff": [
          "grid.import_power",
          "ac.total_power"
        ]
      }
    },
    {
      "key": "battery.charge_power",
      "role": "extra.battery_charge_power",
      "compute": {
        "clamp": {
          "key": "battery.power",
          "min": 0
        }
      }
    },
    {
      "key": "battery.discharge_power",
      "role": "extra.battery_discharge_power",
      "compute": {
        "diff": [
          "battery.charge_power",
          "battery.power"
        ]
      }
    },
    {
      "key": "inverter.power",
      "role": "extra.inverter_power",
      "compute": {
        "combine": {
          "add": [
            "dc.total_power",
            "ac.total_power"
          ],
          "sub": [
            "battery.power",
            "ac.ups.total_power"
          ]
        }
      }
    },
    {
      "key": "inverter.efficiency",
      "role": "extra.inverter_efficiency",
      "compute": {
        "ratio": {
          "num": [
            "ac.ups.total_power",
            "battery.charge_power",
            "grid.export_power"
          ],
          "den": [
            "dc.total_power",
            "battery.discharge_power",
            "grid.import_power"
          ],
          "scale": 100
        }
      },
      "range": {
        "min": 0,
        "max": 100
      }
    }
