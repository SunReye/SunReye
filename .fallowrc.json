{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["profiles/*.ts"],
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "tools/oxlint/anti-slop/**",
    "target/**",
    "**/.svelte-kit/**",
    "apps/web/src/lib/components/ui/**",
    "packages/builder/src/motion.ts",
    "packages/ui/src/alert/**",
    "packages/ui/src/button/**",
    "packages/ui/src/calendar/**",
    "packages/ui/src/card/**",
    "packages/ui/src/checkbox/**",
    "packages/ui/src/dialog/**",
    "packages/ui/src/drawer/**",
    "packages/ui/src/dropdown-menu/**",
    "packages/ui/src/input/**",
    "packages/ui/src/item/**",
    "packages/ui/src/popover/**",
    "packages/ui/src/pressable/**",
    "packages/ui/src/separator/**",
    "packages/ui/src/slider/**",
    "packages/ui/src/spinner/**",
    "packages/ui/src/toggle/**",
    "packages/ui/src/toggle-group/**",
    "packages/ui/src/track-active.ts",
    "packages/ui/src/utils.ts",
    "apps/web/src/lib/hooks/**"
  ],
  "ignoreBinaries": ["systemd-analyze"],
  "ignoreDependencies": [
    "@oxlint/plugins",
    "@inlang/plugin-message-format",
    "@lucide/svelte",
    "bits-ui",
    "clsx",
    "svelte-sonner",
    "tailwind-merge",
    "tailwind-variants"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "deprecated-exports-in-use": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-namespace-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "absent-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "complexity-file-lines": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unlisted-binaries": "error",
    "duplicate-exports": "error",
    "duplicate-export-aliases": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "package-cycle": "error",
    "boundary-violation": "error",
    "coverage-gaps": "error",
    "feature-flags": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
    "weakened-tests": "error",
    "added-suppression": "error",
    "test-only-branch": "error",
    "diverged-clone-sibling": "error",
    "added-dependency": "error"
  },
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 10,
    "maxCrap": 30
  },
  "duplicates": {
    "minTokens": 40,
    "minLines": 5,
    "ignore": ["apps/web/src/lib/api/schema.d.ts", "packages/scene/schema.d.ts"]
  },
  "boundaries": {
    "zones": [
      {
        "name": "web",
        "patterns": ["apps/web/**"]
      },
      {
        "name": "sdk",
        "patterns": ["packages/sdk/**"]
      },
      {
        "name": "tokens",
        "patterns": ["packages/tokens/**"]
      },
      {
        "name": "catalogue",
        "patterns": ["packages/catalogue/**"]
      },
      {
        "name": "scene",
        "patterns": ["packages/scene/**"]
      },
      {
        "name": "ui",
        "patterns": ["packages/ui/**"]
      },
      {
        "name": "pv-wasm",
        "patterns": ["packages/pv-wasm/**"]
      },
      {
        "name": "builder",
        "patterns": ["packages/builder/**"]
      },
      {
        "name": "profiles",
        "patterns": ["profiles/**"]
      },
      {
        "name": "tooling",
        "patterns": ["scripts/**", "tools/**"]
      }
    ],
    "rules": [
      {
        "from": "web",
        "allow": ["tokens", "catalogue", "scene", "ui", "pv-wasm", "builder"]
      },
      {
        "from": "sdk",
        "allow": []
      },
      {
        "from": "tokens",
        "allow": []
      },
      {
        "from": "catalogue",
        "allow": []
      },
      {
        "from": "scene",
        "allow": []
      },
      {
        "from": "ui",
        "allow": []
      },
      {
        "from": "pv-wasm",
        "allow": ["scene"]
      },
      {
        "from": "builder",
        "allow": ["scene", "pv-wasm", "ui", "catalogue"]
      },
      {
        "from": "profiles",
        "allow": ["sdk"]
      },
      {
        "from": "tooling",
        "allow": ["web", "sdk", "tokens", "catalogue", "scene", "ui", "pv-wasm", "profiles"]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  }
}
