{
  "$schema": "https://docs.fallow.tools/schema.json",
  "ignorePatterns": [
    "apps/web/e2e/**",
    "apps/web/playwright.config.ts",
    "apps/web/src/lib/components/ui/**",
    "apps/web/src/lib/hooks/**",
    "apps/web/src/lib/utils.ts",
    "packages/backend/data/**"
  ],
  "ignoreDependencies": ["sharp", "zod"],
  "dynamicallyLoaded": ["apps/docs/src/styles/theme.css"],
  "usedClassMembers": [{ "implements": "InverterSource", "members": ["read"] }],
  "production": { "deadCode": true },
  "audit": { "gate": "all" },
  "includeEntryExports": true,
  "publicPackages": ["@sunreye/profile-sdk", "@SunReye/inverter-core"],
  "ignoreExports": [
    { "file": "apps/docs/astro.config.mjs", "exports": ["*"] },
    { "file": "apps/server/tsdown.config.ts", "exports": ["*"] },
    { "file": "apps/web/svelte.config.js", "exports": ["*"] },
    { "file": "packages/db/drizzle.config.ts", "exports": ["*"] },
    { "file": "packages/profile-sdk/tsdown.config.ts", "exports": ["*"] },
    { "file": "scripts/require-tests.ts", "exports": ["*"] },
    { "file": "scripts/coverage-floor.ts", "exports": ["*"] },
    { "file": "scripts/mock-hygiene.ts", "exports": ["*"] },
    { "file": "scripts/nginx-locations.ts", "exports": ["*"] }
  ],
  "boundaries": {
    "zones": [
      { "name": "web", "patterns": ["apps/web/src/**"] },
      { "name": "server", "patterns": ["apps/server/src/**"] },
      { "name": "docs", "patterns": ["apps/docs/src/**"] },
      { "name": "db", "patterns": ["packages/db/src/**"] },
      { "name": "auth", "patterns": ["packages/auth/src/**"] },
      { "name": "contracts", "patterns": ["packages/contracts/src/**"] },
      { "name": "env", "patterns": ["packages/env/src/**"] },
      { "name": "inverter-core", "patterns": ["packages/inverter-core/src/**"] },
      { "name": "profile-sdk", "patterns": ["packages/profile-sdk/src/**"] },
      {
        "name": "tooling",
        "patterns": ["scripts/**", "apps/*/scripts/**", "packages/*/scripts/**", "**/*.config.*"]
      }
    ],
    "rules": [
      {
        "from": "web",
        "allow": ["env", "auth", "inverter-core", "contracts"]
      },
      {
        "from": "server",
        "allow": ["db", "auth", "env", "inverter-core", "profile-sdk", "contracts"]
      },
      { "from": "contracts", "allow": [], "allowTypeOnly": ["db", "inverter-core"] },
      { "from": "db", "allow": ["env"] },
      { "from": "auth", "allow": ["db", "env"] },
      { "from": "inverter-core", "allow": [] },
      { "from": "profile-sdk", "allow": ["inverter-core"] },
      { "from": "env", "allow": [] },
      { "from": "docs", "allow": [] },
      {
        "from": "tooling",
        "allow": [
          "web",
          "server",
          "docs",
          "db",
          "auth",
          "env",
          "inverter-core",
          "profile-sdk",
          "contracts"
        ]
      }
    ],
    "coverage": { "requireAllFiles": true },
    "calls": {
      "forbidden": [
        { "from": "web", "callee": ["fs.*", "node:fs.*", "child_process.*", "eval"] },
        { "from": "inverter-core", "callee": ["fetch", "fs.*", "node:fs.*", "child_process.*"] },
        { "from": "db", "callee": ["fetch", "child_process.*"] },
        { "from": "env", "callee": ["fetch", "child_process.*"] },
        { "from": "server", "callee": ["eval"] }
      ]
    }
  },
  "rules": {
    "private-type-leaks": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-store-members": "error",
    "unused-svelte-events": "error",
    "unused-load-data-keys": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unused-dependency-overrides": "error",
    "policy-violation": "error",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "security-client-server-leak": "error",
    "security-sink": "error"
  },
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 10,
    "maxCrap": 30
  },
  "duplicates": {
    "minTokens": 40,
    "minLines": 5
  }
}
