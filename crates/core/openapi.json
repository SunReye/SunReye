{
  "components": {
    "schemas": {
      "Change": {
        "description": "A layout change: every string, applying from an instant on.",
        "properties": {
          "appliesFrom": {
            "description": "RFC 3339.",
            "type": "string"
          },
          "strings": {
            "items": {
              "$ref": "#/components/schemas/StringDraft"
            },
            "type": "array"
          }
        },
        "required": [
          "appliesFrom",
          "strings"
        ],
        "type": "object"
      },
      "Code": {
        "description": "Every stable machine code the core answers with; the SPA maps each to text (ADR 11).",
        "enum": [
          "request.route",
          "request.method",
          "request.path",
          "request.query",
          "request.body",
          "auth.setup",
          "auth.required",
          "auth.credentials",
          "auth.backoff",
          "auth.configured",
          "auth.password",
          "history.range",
          "history.counter",
          "forecast.range",
          "layout.none",
          "layout.device",
          "layout.input",
          "layout.string",
          "layout.module-type",
          "layout.value",
          "clock.unsynced",
          "internal"
        ],
        "type": "string"
      },
      "Condition": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Code",
            "description": "A stable machine code, such as `clock.unsynced`."
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "Datasheet": {
        "description": "A PV module model's datasheet values.",
        "properties": {
          "bypassDiodes": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "currentCoefficient": {
            "format": "double",
            "type": "number"
          },
          "height": {
            "format": "double",
            "type": "number"
          },
          "imp": {
            "format": "double",
            "type": "number"
          },
          "isc": {
            "format": "double",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "pmax": {
            "description": "Watts at standard test conditions.",
            "format": "double",
            "type": "number"
          },
          "powerCoefficient": {
            "description": "Of Pmax, Voc and Isc, in %/K.",
            "format": "double",
            "type": "number"
          },
          "vmp": {
            "description": "Volts and amperes at the maximum power point.",
            "format": "double",
            "type": "number"
          },
          "voc": {
            "description": "Open-circuit volts and short-circuit amperes.",
            "format": "double",
            "type": "number"
          },
          "voltageCoefficient": {
            "format": "double",
            "type": "number"
          },
          "width": {
            "description": "Metres.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "name",
          "pmax",
          "vmp",
          "imp",
          "voc",
          "isc",
          "powerCoefficient",
          "voltageCoefficient",
          "currentCoefficient",
          "width",
          "height",
          "bypassDiodes"
        ],
        "type": "object"
      },
      "ForecastPoint": {
        "properties": {
          "issued": {
            "description": "When the value was issued, RFC 3339, UTC.",
            "type": "string"
          },
          "target": {
            "description": "RFC 3339, UTC.",
            "type": "string"
          },
          "value": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "target",
          "issued",
          "value"
        ],
        "type": "object"
      },
      "Forecasts": {
        "description": "One series' forecasts, at most 1,500 points.",
        "properties": {
          "points": {
            "description": "By target.",
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "type": "array"
          }
        },
        "required": [
          "points"
        ],
        "type": "object"
      },
      "Frame": {
        "description": "Values by device id, then by series name, such as `pv.mppt.power[2]`.",
        "properties": {
          "devices": {
            "additionalProperties": {
              "additionalProperties": {
                "format": "double",
                "type": "number"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "devices"
        ],
        "type": "object"
      },
      "History": {
        "description": "Time-weighted means of one series over a range, at the tier the server picked.",
        "properties": {
          "points": {
            "description": "In time order; a gap has no point.",
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          },
          "width": {
            "description": "A `bucket`'s width in seconds.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "tier",
          "points"
        ],
        "type": "object"
      },
      "Layout": {
        "description": "One layout version.",
        "properties": {
          "appliesFrom": {
            "description": "RFC 3339, UTC.",
            "type": "string"
          },
          "strings": {
            "items": {
              "$ref": "#/components/schemas/PvString"
            },
            "type": "array"
          }
        },
        "required": [
          "appliesFrom",
          "strings"
        ],
        "type": "object"
      },
      "ModuleType": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Datasheet"
          },
          {
            "properties": {
              "id": {
                "description": "Stable; never reused.",
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          }
        ]
      },
      "ModuleTypes": {
        "properties": {
          "moduleTypes": {
            "items": {
              "$ref": "#/components/schemas/ModuleType"
            },
            "type": "array"
          }
        },
        "required": [
          "moduleTypes"
        ],
        "type": "object"
      },
      "Point": {
        "properties": {
          "end": {
            "description": "RFC 3339, UTC.",
            "type": "string"
          },
          "mean": {
            "description": "The value weighted by the time it held between `start` and `end`.",
            "format": "double",
            "type": "number"
          },
          "start": {
            "description": "RFC 3339, UTC.",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "mean"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "The body of a refusal.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Code",
            "description": "A stable machine code, such as `auth.required`."
          },
          "status": {
            "description": "The HTTP status.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "status",
          "code"
        ],
        "type": "object"
      },
      "Problems": {
        "description": "Conditions that degrade the core.",
        "properties": {
          "problems": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "type": "array"
          }
        },
        "required": [
          "problems"
        ],
        "type": "object"
      },
      "PvString": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Wiring"
          },
          {
            "properties": {
              "id": {
                "description": "Stable; never reused. The `pv.string.power` index.",
                "format": "int32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          }
        ],
        "description": "Modules in series on one plane; strings on one MPPT input are in parallel."
      },
      "Schemas": {
        "description": "An inclusive range of profile schemas.",
        "properties": {
          "max": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "min": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "min",
          "max"
        ],
        "type": "object"
      },
      "StringDraft": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Wiring"
          },
          {
            "properties": {
              "id": {
                "description": "A string kept from an earlier version; absent for a new string.",
                "format": "int32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "Support": {
        "description": "What this core supports (ADR 9). The schemas and capabilities are the profile crate's table,\nthe one its WASM build reports.",
        "properties": {
          "capabilities": {
            "description": "The bindings, decoders and computed quantities a profile may require.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schema": {
            "$ref": "#/components/schemas/Schemas",
            "description": "The profile schemas this core loads."
          },
          "transports": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "version": {
            "description": "The core's version.",
            "type": "string"
          }
        },
        "required": [
          "version",
          "schema",
          "capabilities",
          "transports"
        ],
        "type": "object"
      },
      "Tier": {
        "description": "`raw` intervals between change points, UTC-aligned buckets of them, or `hour` (UTC) or\n`day` (plant-local) rollups.",
        "enum": [
          "raw",
          "bucket",
          "hour",
          "day"
        ],
        "type": "string"
      },
      "Wiring": {
        "description": "Where a string sits and what it is made of.",
        "properties": {
          "azimuth": {
            "description": "Degrees: 0 south, −90 east, 90 west.",
            "format": "double",
            "type": "number"
          },
          "device": {
            "description": "The inverter's device id.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "input": {
            "description": "The MPPT input, from 1, as the `pv.mppt.*` index.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "loss": {
            "description": "Wiring, soiling and mismatch, in %.",
            "format": "double",
            "type": "number"
          },
          "moduleType": {
            "description": "A module type id.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "modules": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "optimized": {
            "description": "How many of its modules have an optimizer.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tilt": {
            "description": "Degrees from horizontal.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "name",
          "moduleType",
          "device",
          "input",
          "modules",
          "optimized",
          "tilt",
          "azimuth",
          "loss"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only"
    },
    "title": "SunReye",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Support"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{id}/forecasts": {
      "get": {
        "operationId": "forecasts",
        "parameters": [
          {
            "description": "The device id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "A series such as `pv.string.power[3]`.",
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The first target, RFC 3339.",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The instant after the last target, RFC 3339.",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only issues before this instant, RFC 3339; the latest issue when absent.",
            "in": "query",
            "name": "issuedBefore",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forecasts"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{id}/history": {
      "get": {
        "operationId": "history",
        "parameters": [
          {
            "description": "The device id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "A series such as `pv.mppt.power[2]`.",
            "in": "query",
            "name": "series",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The first instant, RFC 3339.",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The instant after the last, RFC 3339.",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/layout": {
      "get": {
        "operationId": "layout",
        "parameters": [
          {
            "description": "RFC 3339; now when absent.",
            "in": "query",
            "name": "at",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Layout"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "The layout in force at an instant."
      },
      "put": {
        "operationId": "change_layout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Change"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Layout"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Changes the layout from an instant on; new strings get fresh ids."
      }
    },
    "/api/v1/live": {
      "get": {
        "operationId": "live_values",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Frame"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Server-sent events: a `snapshot` of every value on connect, then a `delta` per second in\nwhich a value changed. There is no replay: a client that falls behind is disconnected and\nreconnects to a fresh snapshot."
      }
    },
    "/api/v1/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in; the cookie is set"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Signs the admin in to a session cookie."
      }
    },
    "/api/v1/module-types": {
      "get": {
        "operationId": "list_module_types",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleTypes"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "add_module_type",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Datasheet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleType"
                }
              }
            }
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Adds a module type; the admin enters its datasheet, there is no catalogue."
      }
    },
    "/api/v1/problems": {
      "get": {
        "operationId": "problems",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problems"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "204": {
            "description": "Signed in"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Whether the request carries a live session."
      }
    },
    "/api/v1/setup": {
      "post": {
        "operationId": "setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The admin password is set"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "The first run sets the admin password; there is no registration."
      }
    }
  }
}
