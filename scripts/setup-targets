#!/usr/bin/env bash
# Installs what scripts/target-gate needs for the Android build (ADR 0006) and the sqlx-cli that
# scripts/sqlx-cache needs (ADR 0004). Idempotent: only what is
# missing is fetched. Needs about 2 GB under $SUNREYE_TARGETS_HOME (default ~/.cache/sunreye-targets)
# plus the Android rustup target and cargo-ndk.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# shellcheck source=lib/targets.sh
source scripts/lib/targets.sh

install_ndk() {
  local zip
  zip=$(mktemp --suffix=.zip)
  curl -fsSL -o "$zip" "https://dl.google.com/android/repository/android-ndk-$NDK_VERSION-linux.zip"
  mkdir -p "$TARGETS_HOME"
  unzip -q "$zip" -d "$TARGETS_HOME"
  rm -f "$zip"
}

for piece in $(missing_pieces); do
  echo "== $piece"
  case $piece in
    android-target) rustup target add "$ANDROID_TARGET" ;;
    cargo-ndk) cargo install cargo-ndk --locked ;;
    ndk) install_ndk ;;
  esac
done
if ! command -v cargo-sqlx >/dev/null; then
  echo "== sqlx-cli"
  cargo install sqlx-cli --locked --no-default-features --features sqlite
fi
echo "targets ready: scripts/target-gate"
