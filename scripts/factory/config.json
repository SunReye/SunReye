{
  "repo": "SunReye/SunReye",
  "host": "github.com",
  "base": "v4",
  "slots": {
    "impl": 3,
    "merge": 1
  },
  "slot_node_modules_cap_gb": 4,
  "cargo_build_jobs": 2,
  "disk_pause_free_gb": 30,
  "disk_critical_free_gb": 15,
  "max_attempts": 3,
  "max_pr_files": 50,
  "max_pr_lines": 3000,
  "generated_paths": [
    "*.gen.ts",
    "*_snapshot.json",
    "bun.lock",
    "Cargo.lock",
    "timing-baseline.json"
  ],
  "max_waiting_prs": 3,
  "max_train_prs": 5,
  "slot_nice": 10,
  "max_parallel_reviews": 4,
  "require_ci": false,
  "golden_paths": [
    "golden",
    "fixtures/",
    "/oracle/cases/"
  ],
  "vitest_workers_per_slot": 2,
  "playwright_workers_per_slot": 2,
  "ui_epic": null,
  "protected_branches": [
    "main",
    "master",
    "stable"
  ],
  "clean_paths": [
    "target"
  ],
  "generated_conflict_paths": [
    "bun.lock",
    "Cargo.lock",
    "*.gen.ts",
    "crates/sunreye/openapi_snapshot.json",
    ".sqlx/*",
    "scripts/timing-baseline.json"
  ],
  "commands": {
    "install": [
      [
        "bun",
        "install",
        "--frozen-lockfile"
      ]
    ],
    "prepare": [],
    "regenerate": [
      [
        "bun",
        "install"
      ],
      [
        "env",
        "UPDATE_OPENAPI=1",
        "cargo",
        "test",
        "-p",
        "sunreye",
        "openapi"
      ],
      [
        "bun",
        "run",
        "--cwd",
        "apps/web",
        "gen:core-api"
      ],
      [
        "bun",
        "run",
        "--cwd",
        "packages/inverter-core",
        "gen:profile"
      ],
      [
        "scripts/sqlx-cache"
      ],
      [
        "bun",
        "scripts/timing-hygiene.ts",
        "--write"
      ]
    ],
    "gate": [
      [
        "scripts/ci"
      ]
    ],
    "train_gate": [
      [
        "scripts/ci",
        "--train"
      ]
    ]
  }
}
