#!/usr/bin/env bash
# The Rust steps of the merge gate. Any failing step fails the gate.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "== cargo fmt"
cargo fmt --check
# The query! macros read the committed .sqlx cache; a stale one names `cargo sqlx prepare` as the fix.
echo "== sqlx cache"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
(
  export DATABASE_URL="sqlite:$scratch/check.db"
  cargo sqlx database setup --source crates/sunreye/migrations
  cargo sqlx prepare --check --workspace -- --all-targets
)
echo "== cargo clippy"
cargo clippy --workspace --all-targets -- -D warnings
echo "== cargo test"
cargo test --workspace
