{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.base.json"],
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "tools/oxlint/anti-slop/**",
    "fixtures/consumer/**",
    "apps/home/core/openapi.json",
    "apps/home/web/src/lib/api/schema.d.ts",
    "packages/sdk/src/generated.ts",
    "packages/scene/schema.d.ts",
    "packages/scene/scene-schema.js",
    "target/**",
    "apps/home/web/src/lib/components/ui/**",
    "packages/builder/src/motion.ts",
    "packages/ui/src/alert/**",
    "packages/ui/src/button/**",
    "packages/ui/src/calendar/**",
    "packages/ui/src/card/**",
    "packages/ui/src/checkbox/**",
    "packages/ui/src/context-menu/**",
    "packages/ui/src/dialog/**",
    "packages/ui/src/drawer/**",
    "packages/ui/src/dropdown-menu/**",
    "packages/ui/src/input/**",
    "packages/ui/src/item/**",
    "packages/ui/src/popover/**",
    "packages/ui/src/pressable/**",
    "packages/ui/src/separator/**",
    "packages/ui/src/slider/**",
    "packages/ui/src/spinner/**",
    "packages/ui/src/toggle/**",
    "packages/ui/src/toggle-group/**",
    "packages/ui/src/track-active.ts",
    "packages/ui/src/utils.ts",
    "apps/home/web/src/lib/hooks/**",
    "**/.svelte-kit/**"
  ],
  "rules": {
    "svelte/button-has-type": "error",
    "svelte/no-at-html-tags": "error",
    "svelte/no-navigation-without-resolve": "off",
    "svelte/no-unused-class-name": "off",
    "svelte/no-useless-mustaches": "off",
    "svelte/prefer-destructured-store-props": "off",
    "svelte/prefer-svelte-reactivity": "off",
    "svelte/require-optimized-style-attribute": "off"
  },
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
